# Git ignore rules

# Ignore python cache files
__pycache__/
*.pyc
*.pyo

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore virtual environment directories
venv/
.venv/
env/

# Ignore sensitive configuration files
data_module/config.json

# Ignore log files
*.log

# Ignore local non-code reference assets and ad-hoc exports
*.pdf
*.xlsx
*.xls
*.docx
*.pptx
*_dump.txt
import_dump.txt

# Ignore IDE/Editor specific files
.idea/
.vscode/
*.swp

# Additional rules
logs/
dist/ 
research/
.hypothesis/
.kiro/
projects/
